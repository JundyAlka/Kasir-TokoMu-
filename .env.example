# Postgres connection string. Local Docker default uses port 5439 (see README).
DATABASE_URL=postgres://postgres:postgres@localhost:5439/warungos

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret

# URL server (server-side). Untuk VPS: https://domain-kamu.com atau http://IP:3000
BETTER_AUTH_URL=http://localhost:3000

# URL server (client-side, di-embed saat build). Harus sama dengan BETTER_AUTH_URL.
# WAJIB diset di VPS agar login tidak "Invalid origin"!
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# (Opsional) Origin tambahan yang dipercaya, dipisah koma
# Gunakan jika akses lewat IP langsung: BETTER_AUTH_TRUSTED_ORIGINS=http://123.45.67.89:3000
BETTER_AUTH_TRUSTED_ORIGINS=

# AI API (server-side only). Supports an OpenAI-compatible provider such as Juan Router.
# Put the real key only in .env.local; never commit it.
JUAN_ROUTER_API_KEY=replace-with-provider-key
# Legacy alias still supported:
# GEMINI_API_KEY=replace-with-provider-key
GEMINI_BASE_URL=https://router.juan.web.id/v1
GEMINI_TEXT_MODEL=deepseek-v4-flash
GEMINI_FALLBACK_TEXT_MODEL=deepseek-v4-flash
GEMINI_FALLBACK_TEXT_MODEL_PINNED=deepseek-v4-flash
# Each provider request is stopped safely after 60 seconds (allowed range: 5-90 seconds).
GEMINI_REQUEST_TIMEOUT_MS=60000
GEMINI_VISION_MODEL=gemini-2.0-flash
