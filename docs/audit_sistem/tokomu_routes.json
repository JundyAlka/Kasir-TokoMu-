{
  "project_name": "TokoMu (WarungOS)",
  "frontend_routes": [
    { "path": "/", "file": "src/app/page.tsx", "allowed_roles": ["Semua (Redirect)"], "action": "Mengalihkan pengguna ke /dashboard" },
    { "path": "/auth", "file": "src/app/auth/page.tsx", "allowed_roles": ["Publik / Tamu"], "action": "Menampilkan halaman Login dengan Better Auth email/password" },
    { "path": "/admin/login", "file": "src/app/admin/login/page.tsx", "allowed_roles": ["Publik / Tamu (Redirect)"], "action": "Mengalihkan pengguna dari URL lama /admin/login ke /auth" },
    { "path": "/dashboard", "file": "src/app/(dashboard)/dashboard/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "action": "Menampilkan ringkasan omzet, laba bersih, kasbon, dan grafik toko" },
    { "path": "/kasir", "file": "src/app/(dashboard)/kasir/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "action": "Menampilkan antarmuka POS penjualan, pembukaan/penutupan shift, dan cetak struk" },
    { "path": "/inventaris", "file": "src/app/(dashboard)/inventaris/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "action": "Menampilkan katalog produk, penambahan/edit barang, dan modal OCR scan struk" },
    { "path": "/buku-hutang", "file": "src/app/(dashboard)/buku-hutang/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "action": "Menampilkan daftar kasbon aktif/lewat tempo, form hutang baru, dan pencatatan cicilan" },
    { "path": "/investor", "file": "src/app/(dashboard)/investor/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "action": "Menampilkan daftar investor dengan tombol Tambah Investor yang membuka pop-up modal langsung" },
    { "path": "/investor/baru", "file": "src/app/(dashboard)/investor/baru/page.tsx", "allowed_roles": ["Semua (Redirect)"], "action": "Mengalihkan alur lawas /investor/baru kembali ke /investor untuk menegakkan alur modal pop-up" },
    { "path": "/investor/[id]", "file": "src/app/(dashboard)/investor/[id]/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "action": "Menampilkan rincian investor dan akad investasi uang/barang titip jual" },
    { "path": "/bagi-hasil", "file": "src/app/(dashboard)/bagi-hasil/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "action": "Menghitung dan memproses bagi hasil bulanan kepada investor" },
    { "path": "/laporan", "file": "src/app/(dashboard)/laporan/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "action": "Menyusun rekap laporan laba rugi bulanan, finalisasi/kunci, dan unduh PDF" },
    { "path": "/laporan-pcm", "file": "src/app/(dashboard)/laporan-pcm/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "action": "Menyusun laporan khusus bagi hasil PCM & Cadangan beserta unduh PDF resmi" },
    { "path": "/pengaturan", "file": "src/app/(dashboard)/pengaturan/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "action": "Mengatur nama warung, alamat, persentase bagi hasil PCM/Cadangan, dan metode pembayaran" },
    { "path": "/pengaturan/karyawan", "file": "src/app/(dashboard)/pengaturan/karyawan/page.tsx", "allowed_roles": ["pimpinan"], "action": "Mengelola daftar staf, mengundang karyawan via email/token, dan menonaktifkan pengguna" },
    { "path": "/pengaturan/audit-log", "file": "src/app/(dashboard)/pengaturan/audit-log/page.tsx", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "action": "Melihat rekam jejak aktivitas keamanan dan perubahan data dengan filter" }
  ],
  "backend_endpoints": [
    { "path": "/api/auth/[...all]", "method": "ALL", "allowed_roles": ["Publik"], "controller": "src/lib/auth.ts", "purpose": "Handler internal Better Auth untuk login, register, logout, dan manajemen sesi" },
    { "path": "/api/auth/get-session", "method": "GET", "allowed_roles": ["Publik / Terautentikasi"], "controller": "src/app/api/auth/get-session/route.ts", "purpose": "Mengambil informasi sesi dan user saat ini" },
    { "path": "/api/bootstrap", "method": "GET", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/bootstrap/route.ts", "purpose": "Mengambil data inisial workspace secara terpadu" },
    { "path": "/api/products", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/products/route.ts", "purpose": "Melihat daftar produk dan menambah produk baru" },
    { "path": "/api/products/[id]", "method": "PUT, DELETE", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/products/[id]/route.ts", "purpose": "Memperbarui atau menghapus produk eksisting" },
    { "path": "/api/restock", "method": "POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/restock/route.ts", "purpose": "Menambahkan kuantitas stok produk dan mencatat log restok manual" },
    { "path": "/api/transactions", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/transactions/route.ts", "purpose": "Melihat riwayat transaksi dan membuat transaksi penjualan baru di POS" },
    { "path": "/api/debts", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/debts/route.ts", "purpose": "Melihat daftar kasbon dan membuat catatan hutang baru" },
    { "path": "/api/debts/[id]", "method": "GET, PUT, PATCH", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/debts/[id]/route.ts", "purpose": "Detail hutang, update status, atau menandai lunas" },
    { "path": "/api/debts/[id]/payments", "method": "POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/debts/[id]/payments/route.ts", "purpose": "Mencatat cicilan atau pembayaran kasbon oleh pelanggan" },
    { "path": "/api/debts/[id]/remind", "method": "POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/debts/[id]/remind/route.ts", "purpose": "Mencatat pengiriman pengingat WhatsApp ke penghutang" },
    { "path": "/api/investors", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/investors/route.ts", "purpose": "Melihat daftar investor dan membuat profil investor baru via pop-up dialog" },
    { "path": "/api/investors/[id]", "method": "GET, PUT, DELETE", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/investors/[id]/route.ts", "purpose": "Detail, perbaharui data, atau nonaktifkan investor" },
    { "path": "/api/investments", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/investments/route.ts", "purpose": "Melihat daftar investasi dan membuat akad investasi uang/barang titipan baru" },
    { "path": "/api/investments/[id]", "method": "PUT, DELETE", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/investments/[id]/route.ts", "purpose": "Memperbarui atau menutup investasi yang telah selesai" },
    { "path": "/api/payouts", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/payouts/route.ts", "purpose": "Melihat kalkulasi dan memproses bagi hasil bulanan" },
    { "path": "/api/payouts/[id]", "method": "PUT, DELETE", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/payouts/[id]/route.ts", "purpose": "Menyetujui/membayarkan payout atau menghapus draft" },
    { "path": "/api/reports/monthly", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/reports/monthly/route.ts", "purpose": "Melihat dan mengkalkulasi/menyimpan draft laporan keuangan bulanan" },
    { "path": "/api/reports/monthly/[id]/finalize", "method": "POST", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/reports/monthly/[id]/finalize/route.ts", "purpose": "Mengunci laporan bulanan menjadi final" },
    { "path": "/api/reports/monthly/[id]/pdf", "method": "GET", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/reports/monthly/[id]/pdf/route.ts", "purpose": "Mengunduh file PDF Laporan Laba Rugi Bulanan" },
    { "path": "/api/reports/pcm/pdf", "method": "GET", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/reports/pcm/pdf/route.ts", "purpose": "Mengunduh file PDF Laporan Bagi Hasil Khusus PCM & Cadangan" },
    { "path": "/api/shifts", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/shifts/route.ts", "purpose": "Melihat dan menambah jadwal shift operasional" },
    { "path": "/api/shifts/[id]", "method": "PUT, DELETE", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/shifts/[id]/route.ts", "purpose": "Memperbarui jam atau menonaktifkan shift" },
    { "path": "/api/shift-sessions", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/shift-sessions/route.ts", "purpose": "Melihat riwayat sesi shift dan membuka sesi shift kasir baru" },
    { "path": "/api/shift-sessions/[id]/close", "method": "POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/shift-sessions/[id]/close/route.ts", "purpose": "Menutup sesi shift kasir, menghitung kas ekspektasi, dan mencatat selisih" },
    { "path": "/api/users", "method": "GET", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/users/route.ts", "purpose": "Melihat daftar pengguna aktif di dalam workspace" },
    { "path": "/api/users/invite", "method": "POST", "allowed_roles": ["pimpinan"], "controller": "src/app/api/users/invite/route.ts", "purpose": "Mengirim undangan dan membuat token bergabung ke workspace untuk staf" },
    { "path": "/api/users/invitations/[id]", "method": "DELETE", "allowed_roles": ["pimpinan"], "controller": "src/app/api/users/invitations/[id]/route.ts", "purpose": "Membatalkan undangan yang belum diterima" },
    { "path": "/api/users/invitations/accept", "method": "POST", "allowed_roles": ["Semua pengguna login"], "controller": "src/app/api/users/invitations/accept/route.ts", "purpose": "Menerima undangan menggunakan token dan masuk ke workspace pemilik" },
    { "path": "/api/users/[id]", "method": "DELETE", "allowed_roles": ["pimpinan"], "controller": "src/app/api/users/[id]/route.ts", "purpose": "Menonaktifkan staf dari workspace" },
    { "path": "/api/settings", "method": "GET, PUT", "allowed_roles": ["pimpinan", "pengelola_keuangan"], "controller": "src/app/api/settings/route.ts", "purpose": "Melihat dan memperbarui profil warung, porsi PCM/Cadangan, threshold stok, dan metode bayar" },
    { "path": "/api/settings/reset", "method": "POST", "allowed_roles": ["pimpinan"], "controller": "src/app/api/settings/reset/route.ts", "purpose": "Mereset seluruh data transaksi dan inventaris workspace (Danger Zone)" },
    { "path": "/api/audit-log", "method": "GET", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/audit-log/route.ts", "purpose": "Mengambil log rekam jejak aktivitas dengan filter dan paginasi" },
    { "path": "/api/audit-log/facets", "method": "GET", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/audit-log/facets/route.ts", "purpose": "Mengambil daftar event_type dan aktor untuk filter dropdown" },
    { "path": "/api/ai/chats", "method": "GET, POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/ai/chats/route.ts", "purpose": "Melihat daftar percakapan AI dan membuat sesi chat baru" },
    { "path": "/api/ai/chats/[id]", "method": "GET, DELETE", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/ai/chats/[id]/route.ts", "purpose": "Melihat detail pesan dalam sesi chat atau menghapus riwayat" },
    { "path": "/api/ai/chats/[id]/messages", "method": "POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/ai/chats/[id]/messages/route.ts", "purpose": "Mengirim pesan ke Google Gemini Assistant beserta eksekusi tool calling" },
    { "path": "/api/ai/scan-receipt", "method": "POST", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/ai/scan-receipt/route.ts", "purpose": "Melakukan parsing OCR struk barang titip jual/belanja menggunakan Gemini Vision" },
    { "path": "/api/ai/tools", "method": "GET", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/ai/tools/route.ts", "purpose": "Melihat daftar alat (functions) AI yang tersedia" },
    { "path": "/api/dashboard", "method": "GET", "allowed_roles": ["pimpinan", "pengelola_keuangan", "kasir"], "controller": "src/app/api/dashboard/route.ts", "purpose": "Mengambil data ringkasan dan statistik untuk halaman dashboard" }
  ]
}
